{
  "name": "flux-code",
  "version": "1.0.0",
  "description": "A beautiful live status line for Claude Code: model, git branch, context window, 5-hour and weekly usage, reset countdowns, and session cost.",
  "keywords": [
    "claude",
    "claude-code",
    "statusline",
    "status-line",
    "usage",
    "rate-limits",
    "context-window",
    "cli"
  ],
  "type": "module",
  "bin": {
    "flux-code": "dist/index.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "flux-code.example.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "postbuild": "node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "npm run build && node dist/index.js preview",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "author": "Flux Code contributors",
  "homepage": "https://github.com/im-shubhamsharma/flux-code#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/im-shubhamsharma/flux-code.git"
  },
  "bugs": {
    "url": "https://github.com/im-shubhamsharma/flux-code/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.15.0",
    "prettier": "^3.4.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.8"
  }
}
